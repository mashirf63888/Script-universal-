-- Efeito hover
button.MouseEnter:Connect(function()
    button.BackgroundColor3 = Color3.fromRGB(110, 124, 255)
end)
button.MouseLeave:Connect(function()
    if button.Text ~= "✅  Link Copiado!" then
        button.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    end
end)

-- Link
local link = "https://bloxlink.pw/verify?server=9649913873507285"

-- Ação do botão
button.MouseButton1Click:Connect(function()
    setclipboard(link)
    button.Text = "✅  Link Copiado!"
    button.BackgroundColor3 = Color3.fromRGB(59, 165, 93)
    task.wait(2.5)
    button.Text = "📋  Copiar Link de Verificação"
    button.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
end)
